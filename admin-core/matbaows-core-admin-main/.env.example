APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Optional CDN host for static assets and uploaded media. Leave empty to serve
# them from APP_URL. Uploaded media is stored as a relative path, so image URLs
# always follow APP_URL/ASSET_URL instead of the host used at upload time.
ASSET_URL=

# Set when running behind a TLS-terminating proxy or load balancer, otherwise
# generated asset URLs use the wrong scheme. Use "*" for a trusted balancer or a
# comma-separated list of proxy addresses.
TRUSTED_PROXIES=

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
MULTILINGUAL_ENABLED=true
MULTILINGUAL_MODE=manual
CONTENT_DEFAULT_LOCALE=vi
CONTENT_FALLBACK_LOCALE=vi
TRANSLATION_PROVIDER=google
GOOGLE_TRANSLATE_TIMEOUT=12
TRANSLATION_CACHE_TTL=86400
TRANSLATION_DAILY_CHAR_LIMIT=500000
APP_FAKER_LOCALE=vi_VN

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
# Required by the non-interactive core installer. Never use a default password in production.
ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_EXPIRATION=480

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SELLER="owner@example.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mock payment routes must never be enabled in production.
PAYMENT_MOCK_ENABLED=false
PAYMENT_RETURN_HOSTS=
PUBLIC_FRONTEND_URL=
GHTK_WEBHOOK_ALLOW_QUERY_TOKEN=false
